#!/usr/bin/env bash
# Install/refresh language servers and formatters used by ~/.config/nvim.
# Idempotent: only installs what is missing. Pass --force to reinstall all.
# A failure in one tool does not stop the others; a summary is printed at the end.
set -uo pipefail

force=${1:-}
failed=()

have() { command -v "$1" >/dev/null 2>&1; }
say()  { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!!  %s\033[0m\n' "$*"; }

# rust-analyzer is the only tool outside mise: rustup pairs it with the active
# toolchain, which is what rust-analyzer needs to resolve std and proc macros.
if have rustup; then
    say "rust-analyzer (rustup component)"
    if [[ $force == --force ]] || ! rustup component list --installed 2>/dev/null | grep -q '^rust-analyzer'; then
        rustup component add rust-analyzer || failed+=("rust-analyzer")
    fi
else
    warn "rustup missing: skipping rust-analyzer"
fi

# Everything else goes through mise. `mise use -g` installs *and* records the
# version in ~/.config/mise/config.toml; recording is the part that matters,
# because a shim with no declared version exits with "No version is set for
# shim: <tool>" instead of running -- which reads to Neovim as an LSP that dies
# during startup.
tools=(
    "go:golang.org/x/tools/gopls"
    shfmt
    "github:docker/docker-language-server"
    helm-ls
    lua-language-server
    marksman
    stylua
    "gem:ruby-lsp"
    "gem:standard"
    "gem:rubocop"
    prettier
    "npm:yaml-language-server"
    "npm:vscode-langservers-extracted"
    "npm:bash-language-server"
    "npm:gh-actions-language-server"
    "npm:typescript-language-server"
    "npm:typescript"
)

# One `mise use -g` per tool, on purpose: the multi-argument form is atomic, so
# a single package mise refuses (an unavailable version, a supply-chain guard)
# discards the whole batch and leaves every shim undeclared.
for tool in "${tools[@]}"; do
    say "$tool"
    if [[ $force == --force ]] && ! mise install --force "$tool"; then
        failed+=("$tool")
        continue
    fi
    mise use -g "$tool" || failed+=("$tool")
done

# Gem shims carry the ruby they were built against in their shebang. If that
# ruby is gone the shim resolves but cannot run, so reinstall against the
# current one.
for bin in ruby-lsp standardrb rubocop; do
    if have "$bin" && ! "$bin" --version >/dev/null 2>&1; then
        warn "$bin shim broken (host ruby gone), reinstalling"
        mise install --force "gem:${bin/standardrb/standard}" || failed+=("$bin")
    fi
done
mise reshim 2>/dev/null || true

echo
if (( ${#failed[@]} == 0 )); then
    printf '\033[1;32m==> all done\033[0m\n'
else
    printf '\033[1;31m==> done with %d failure(s):\033[0m\n' "${#failed[@]}"
    for f in "${failed[@]}"; do printf '    - %s\n' "$f"; done
    exit 1
fi
